{
    "name": "re-formality-examples",
    "version": "0.0.0",
    "private": true,
    "scripts": {
        "start": "parcel src/index.html",
        "prestart": "pnpm run clean && pnpm run res:build",
        "build": "parcel build src/index.html",
        "prebuild": "pnpm run clean && pnpm run res:build",
        "clean": "pnpm run dist:clean && pnpm run res:clean",
        "res:build": "rescript build",
        "res:watch": "rescript watch",
        "res:clean": "rescript clean",
        "dist:clean": "rm -rf dist",
        "format": "rescript format",
        "test": "exit 0",
        "deploy": "now deploy dist --prod --name re-formality",
        "predeploy": "pnpm run build"
    },
    "dependencies": {
        "@rescript/react": "0.15.0",
        "re-formality": "link:../lib",
        "react": "19.2.7",
        "react-dom": "19.2.7",
        "rescript-classnames": "8.0.0"
    },
    "devDependencies": {
        "parcel": "2.16.4",
        "process": "0.11.10",
        "rescript": "12.3.0"
    }
}
